# TutorConnect Environment Variables (Template)
# Copy this file to .env.local and populate with your own project configuration.
# DO NOT commit real keys, access tokens, or service role secrets.

# Supabase Project Configuration (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Sandbox / Prototype Mode Controls
# Set to true for development demo payment simulation without payment gateway credentials.
TUTORCONNECT_DEMO_PAYMENT_MODE=true

# Phone Identity & Anti-Abuse Protection (Phase 2 Foundation)
# Server-only HMAC secret used to derive deterministic phone fingerprints.
# NEVER expose to client or prefix with NEXT_PUBLIC_.
# Production requirement: MUST be a cryptographically secure random secret of at least 32 bytes
# (e.g., generate with: openssl rand -hex 32). Secrets shorter than 32 bytes are rejected fail-closed.
TUTORCONNECT_PHONE_FINGERPRINT_SECRET=your_32_byte_minimum_secure_random_secret_here

# Provider Configuration Mode ('disabled' in production until provider is connected)
TUTORCONNECT_PHONE_VERIFICATION_MODE=disabled
